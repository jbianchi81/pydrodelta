{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "concatprocedure.json",
    "title": "concatProcedure",
    "type": "object",
    "description": "Concatenation. Concatenates variables into the output.",
    "allOf": [
        {
            "$ref": "procedure.json"
        }
    ],
    "properties": {
        "type": {
            "type": "string",
            "enum": [
                "Concat",
                "ConcatProcedure",
                "Concatenate",
                "ConcatenateProcedure"
            ]
        },
        "extra_pars": {
            "type": "object",
            "properties": {
                "fill_value": {
                    "type": "number"
                },
                "shift_by": {
                    "type": "number"
                },
                "bias": {
                    "type": "number"
                },
                "extend": {
                    "type": "boolean"
                }
            }
        },
        "boundaries": {
            "oneOf": [
                {
                    "type": "array",
                    "items": {
                        "allOf": [
                            { "$ref": "procedureboundary.json"},
                            {
                                "type": "object",
                                "properties": {
                                    "name": {
                                        "type": "string",
                                        "pattern": "^input_[0-9]+$"
                                    }
                                }
                            }
                        ]
                    },
                    "minItems": 2
                },
                {
                    "type": "array",
                    "description": "list of lists of observations",
                    "items": {
                        "$ref": "observationlist.json"
                    },
                    "minItems": 2
                },
                {
                    "type": "string",
                    "description": "Path to CSV file. First column must be the datetime index. Headers (first row) must indicate output names"
                }
            ]
        },
        "outputs": {
            "oneOf": [
                {
                    "type": "array",
                    "items": {
                        "allOf": [
                            { "$ref": "procedureboundary.json"},
                            {
                                "type": "object",
                                "properties": {
                                    "name": {
                                        "enum": ["output"]
                                    }
                                }
                            }
                        ]
                    },
                    "minItems": 1,
                    "maxItems": 1
                },
                {
                    "type": "array",
                    "description": "list of lists of observations",
                    "items": {
                        "$ref": "observationlist.json"
                    },
                    "minItems": 1,
                    "maxItems": 1
                },
                {
                    "type": "string",
                    "description": "Path to CSV file. First column must be the datetime index. Headers (first row) must indicate output names"
                }
            ]
        }
    },
    "required": [
        "type"
    ]
}